riscillashirer #godstiming \n\n00:00 Intro\n02:40 Family Memories \n10:08 Luke 9:1-2\n16:45 Standing Before God \n20:55 You Need Supernatural Capacity \n33:52 You Need God's Blessing", 'channel_id': 'UCq1BLq3MpYj0-77WKQPu5Cg', 'channel_url': 'https://www.youtube.com/channel/UCq1BLq3MpYj0-77WKQPu5Cg', 'duration': 2421, 'view_count': 991510, 'average_rating': None, 'age_limit': 0, 'webpage_url': 'https://www.youtube.com/watch?v=DYWyQ1xFQSI', 'categories': ['Entertainment'], 'tags': ['priscilla shirer', 'priscilla shirer sermons', 'priscilla shirer 2023', 'priscilla shirer 2022', 'priscilla shirer movies', 'priscilla shirer armor of god', 'priscilla shirer bible study', 'priscilla shirer prayer', 'priscilla shirer identity in christ', 'priscilla shirer motivation', 'women support women', 'victoria osteen', 'purpose', 'timing', "god's timing", 'perfect timing', 'trinity broadcasting network', 'trinity broadcasting network live', 'tbn live', 'matt crouch', 't8b2n6', '8t2b6n', 'tbn826', '826tbn', 'sermon', 'pastor'], 'playable_in_embed': True, 'live_status': 'not_live', 'media_type': None, 'release_timestamp': None, '_format_sort_fields': ('quality', 'res', 'fps', 'hdr:12', 'source', 'vcodec', 'channels', 'acodec', 'lang', 'proto'), 'automatic_captions': {'ab': [{'ext': 'json3', 'url': 'https://www.youtube.com/api/timedtext?v=DYWyQ1xFQSI&ei=nUnCZ4eGH8Xcy_sP3pmf-AI&caps=asr&opi=112496729&xoaf=5&hl=en&ip=0.0.0.0&ipbits=0&expire=1740811277&sparams=ip%2Cipbits%2Cexpire%2Cv%2Cei%2Ccaps%2Copi%2Cxoaf&signature=E9AD37ACDC51ECC84509815DDC688C4054A98515.D29A25ACB6A7A8DDF8A02D2649A6D879AC5160DE&key=yt8&kind=asr&lang=en&tlang=ab&fmt=json3', 'name': 'Abkhazian'}, {'ext': 'srv1', 'url': 'https://www.youtube.com/api/timedtext?v=DYWyQ1xFQSI&ei=nUnCZ4eGH8Xcy_sP3pmf-AI&caps=asr&opi=112496729&xoaf=5&hl=en&ip=0.0.0.0&ipbits=0&expire=1740811277&sparams=ip%2Cipbits%2Cexpire%2Cv%2Cei%2Ccaps%2Copi%2Cxoaf&signature=E9AD37ACDC51ECC84509815DDC688C4054A98515.D29A25ACB6A7A8DDF8A02D2649A6D879AC5160DE&